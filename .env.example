# --- Database ---
DATABASE_URL=postgresql://hfr:hfr@localhost:5432/hfr

# --- API ---
# Comma-separated list of origins allowed by CORS (your deployed frontend URL).
CORS_ORIGINS=http://localhost:8080
# Requests per minute per IP on GET /api/facilities
SEARCH_RATE_LIMIT_PER_MIN=60

# --- Scraper (see README "Running the scraper") ---
# Contact string sent in the User-Agent so the site operator can reach you.
SCRAPER_USER_AGENT=HealthFacilityFinderBot/0.1 (coding challenge; contact: you@example.com)
# Seconds to wait between requests (be polite; raise if you see 429s).
SCRAPER_DELAY_SECONDS=2.0
# Gateway key and base URL as seen in your own browser's network tab on the
# public search page. Deliberately NOT stored in the repo.
NHPR_API_KEY=
NHPR_API_BASE=https://apinhpr.abdm.gov.in/v4/hfr
